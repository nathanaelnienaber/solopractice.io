{
  "name": "solopractice",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first therapy practice management - clinical on desktop, ops on web",
  "scripts": {
    "dev:web": "pnpm --filter @solopractice/web dev",
    "build:web": "pnpm --filter @solopractice/web build",
    "dev:desktop": "pnpm --filter @solopractice/desktop dev",
    "build:desktop": "pnpm --filter @solopractice/desktop build",
    "test": "pnpm -r test",
    "test:shared": "pnpm --filter @solopractice/shared test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @solopractice/web db:generate",
    "db:migrate": "pnpm --filter @solopractice/web db:migrate",
    "db:push": "pnpm --filter @solopractice/web db:push"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0"
}
