{
  "name": "solopractice",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first therapy practice management - clinical on desktop, ops on web",
  "scripts": {
    "dev:web": "pnpm --filter @solopractice/web dev",
    "build:web": "pnpm --filter @solopractice/web build",
    "dev:desktop": "pnpm --filter @solopractice/desktop dev",
    "build:desktop": "pnpm --filter @solopractice/desktop build",
    "test": "pnpm -r test",
    "test:shared": "pnpm --filter @solopractice/shared test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @solopractice/web db:generate",
    "db:migrate": "pnpm --filter @solopractice/web db:migrate",
    "db:push": "pnpm --filter @solopractice/web db:push"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "vite@<=6.4.1": ">=6.4.2",
      "vite@<=6.4.2": ">=6.4.3",
      "vitest@<3.2.6": ">=3.2.6",
      "vitest@>=2.1.0 <4.1.11": ">=4.1.11",
      "@vitest/mocker@>=2.1.0 <4.1.11": ">=4.1.11",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2",
      "tinypool@<=2.1.0": ">=2.1.1",
      "tinypool@<2.1.2": ">=2.1.2",
      "shell-quote@>=1.8.4 <1.11.0": ">=1.11.0",
      "follow-redirects@>=1.16.0 <1.16.1": ">=1.16.1",
      "vite@<=6.4.3": ">=6.4.4",
      "@vitest/mocker@>=2.1.0-beta.7 <4.1.12": ">=4.1.12",
      "zod@<4.6.6": ">=4.6.6",
      "postcss-selector-parser@<6.1.5": ">=6.1.5"
    }
  }
}
