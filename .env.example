# SoloPractice Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env files with real secrets

# =============================================================================
# WEB APPLICATION (apps/web)
# =============================================================================

# Database - Neon Postgres recommended
DATABASE_URL=postgresql://user:password@host:5432/solopractice

# Base URL for the web app (used for magic links, payment redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3847

# Desktop API key (for consent status sync endpoint)
# Generate a secure random string: openssl rand -hex 32
DESKTOP_API_KEY=your-secure-api-key-here

# -----------------------------------------------------------------------------
# Stripe Connect (payments)
# https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Resend (email)
# https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Twilio (SMS reminders)
# https://console.twilio.com
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15551234567

# =============================================================================
# DESKTOP APPLICATION (apps/desktop)
# =============================================================================
# Desktop settings are stored locally in the app.
# Configure via Settings > Web Portal Connection

# Web API URL (for consent status sync)
# Default: http://localhost:3847

# Whisper model size: tiny, base, small, medium, large
# Default: base

# Ollama model for SOAP generation
# Default: llama3.2
